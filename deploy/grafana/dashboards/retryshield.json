      "datasource": {"type": "prometheus", "uid": "retryshield-prometheus"},
      "targets": [{"expr": "sum(rate(retryshield_claims_total[5m]) or rate(retryshield_requests_total[5m])) * 60", "legendFormat": "claims"}]
    },
    {
      "type": "stat", "title": "Replays / min", "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "retryshield-prometheus"},
      "targets": [{"expr": "sum(rate(retryshield_replays_total[5m])) * 60", "legendFormat": "replays"}]
    },
    {
      "type": "stat", "title": "Conflicts / min", "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "retryshield-prometheus"},
      "targets": [{"expr": "sum(rate(retryshield_conflicts_total[5m])) * 60", "legendFormat": "conflicts"}]
    },
    {
      "type": "stat", "title": "Indeterminate / min", "id": 4,
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "retryshield-prometheus"},
      "targets": [{"expr": "sum(rate(retryshield_indeterminate_total[5m])) * 60", "legendFormat": "indeterminate"}]
    },
    {
      "type": "timeseries", "title": "Gateway request latency", "id": 5,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "retryshield-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(retryshield_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(retryshield_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(retryshield_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}
      ]
    }
  ],
