# Copy to deploy/.env for local evaluation. Replace every value in production.
POSTGRES_DB=retryshield
POSTGRES_USER=retryshield
POSTGRES_PASSWORD=local-postgres-change-me
REDIS_PASSWORD=local-redis-change-me

# Generate with: openssl rand -base64 32
RETRYSHIELD_ENCRYPTION_KEY=bG9jYWwtZGV2ZWxvcG1lbnQta2V5LTMyLWJ5dGVzISE=
RETRYSHIELD_ADMIN_API_KEY=dev-admin-token-change-me

GATEWAY_PORT=8080
ADMIN_API_PORT=8081
ADMIN_DASHBOARD_PORT=3000
DEMO_PORT=8082
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=retryshield

MAX_REQUEST_BODY_BYTES=1048576
MAX_RESPONSE_BODY_BYTES=2097152
DUPLICATE_WAIT=00:00:02
RECORD_TTL=1.00:00:00
PROCESSING_TIMEOUT=00:05:00
